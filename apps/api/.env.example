# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://bgym:bgym_local_dev_only@localhost:5432/bgym?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# Secrets: generate your own (e.g. `openssl rand -base64 48`). Values starting with "dev-"
# are refused in production. Never commit real values.
JWT_ACCESS_SECRET=dev-change-me-jwt-secret-at-least-32-characters
OTP_PEPPER=dev-change-me-otp-pepper-at-least-32-characters

# Email: "log" prints sign-in codes to this terminal (development only).
# Production: MAIL_DRIVER=resend and RESEND_API_KEY from https://resend.com
MAIL_DRIVER=log
MAIL_FROM=BGYM <no-reply@bgym.app>
# RESEND_API_KEY=
