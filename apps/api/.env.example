# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://bgym:bgym_local_dev_only@localhost:5432/bgym?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# Secrets: generate your own (e.g. `openssl rand -base64 48`). Values starting with "dev-"
# are refused in production. Never commit real values.
JWT_ACCESS_SECRET=dev-change-me-jwt-secret-at-least-32-characters
OTP_PEPPER=dev-change-me-otp-pepper-at-least-32-characters
# Same value as API_PROXY_SECRET in apps/web/.env.local: lets the dashboard pass on visitors' IPs.
DASHBOARD_PROXY_SECRET=dev-change-me-dashboard-proxy-secret-32-chars

# Email: "log" prints sign-in codes to this terminal (development only).
# Production: MAIL_DRIVER=resend and RESEND_API_KEY from https://resend.com
MAIL_DRIVER=log
MAIL_FROM=BGYM <no-reply@bgym.app>
# RESEND_API_KEY=

# Payments: "dev" simulates successful payments (development only).
# Production: PAYMENTS_DRIVER=paystack with your Paystack secret key.
PAYMENTS_DRIVER=dev
# PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_CALLBACK_URL=bgym://payments/complete

# Push notifications: "log" prints them to this terminal. Production: PUSH_DRIVER=expo
# (optionally EXPO_ACCESS_TOKEN). WEB_URL is used for unsubscribe links in emails.
PUSH_DRIVER=log
WEB_URL=http://localhost:3000

# Photos: "local" stores uploads in ./storage (development). Production: STORAGE_DRIVER=s3 with
# S3_BUCKET, S3_ENDPOINT (Cloudflare R2), S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and MEDIA_PUBLIC_URL.
STORAGE_DRIVER=local

# Renewal reminder emails (7, 3 and 1 days before a membership ends, and when it ends).
REMINDERS_ENABLED=true
