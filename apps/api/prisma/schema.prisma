// BGYM database schema. Source of truth for the data model (docs/05-data-model.md).
// Conventions:
//   - IDs are UUIDv7 (time-ordered, safe to expose).
//   - Money is integer pesewas (GHS × 100), never floats.
//   - Timestamps are timestamptz.
//   - Geographic points use PostGIS geography(Point, 4326) and are read/written with raw SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  member
  gym_staff
  trainer
  partner
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum AuthProvider {
  apple
  google
  email
}

enum GymStatus {
  draft
  pending_review
  active
  suspended
}

enum GymStaffRole {
  owner
  manager
  front_desk
}

enum MembershipStatus {
  pending
  active
  expired
  cancelled
}

/// Which renewal reminder this is. Automatic kinds are sent at most once per membership.
enum ReminderKind {
  days_7
  days_3
  days_1
  expired
  manual
}

enum CheckInResult {
  ok
  expired
  wrong_gym
  invalid
}

enum ContentStatus {
  draft
  published
  hidden
  removed
}

enum PostAuthorKind {
  gym
  member
}

enum VideoPurpose {
  post
  story
}

enum VideoStatus {
  awaiting_upload
  processing
  ready
  failed
}

enum MediaType {
  image
  video
}

enum TrainerStatus {
  pending
  active
  suspended
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum PackageStatus {
  pending
  active
  cancelled
}

enum BookingCanceller {
  member
  trainer
  system
}

enum AvailabilityExceptionType {
  blocked
  extra
}

enum SellerType {
  platform
  partner
}

enum ProductStatus {
  draft
  pending_review
  active
  archived
}

enum OrderStatus {
  pending_payment
  paid
  preparing
  ready_for_pickup
  out_for_delivery
  delivered
  delivery_failed
  cancelled
  refunded
}

enum DeliveryProvider {
  yango
  manual
}

enum DeliveryStatus {
  quoted
  requested
  courier_assigned
  picked_up
  delivered
  failed
  cancelled
}

enum PaymentType {
  membership
  trainer_session
  trainer_package
  store_order
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum PaymentProvider {
  paystack
  dev
}

enum PaymentChannel {
  mobile_money
  card
  bank
  other
}

enum RefundStatus {
  pending
  processed
  failed
}

enum ReportStatus {
  open
  actioned
  dismissed
}

enum DevicePlatform {
  ios
  android
  web
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  email       String     @unique
  phone       String? // E.164, optional: MoMo and delivery only
  name        String?
  avatarUrl   String?
  roles       Role[]     @default([member])
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @db.Timestamptz(3)
  /// When they agreed to the community rules (needed before their first post, story or comment).
  communityAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  identities           AuthIdentity[]
  sessions             Session[]
  memberProfile        MemberProfile?
  gymStaff             GymStaff[]
  trainer              Trainer?
  memberships          Membership[]
  remindersSent        MembershipReminder[]  @relation("ReminderSender")
  invitationsSent      GymInvitation[]       @relation("InvitationSender")
  trainerInvitesSent   TrainerInvitation[]   @relation("TrainerInvitationSender")
  checkIns             CheckIn[]             @relation("CheckInMember")
  scannedCheckIns      CheckIn[]             @relation("CheckInScanner")
  posts                Post[]
  likes                PostLike[]
  comments             PostComment[]
  stories              Story[]
  storyViews           StoryView[]
  storyLikes           StoryLike[]
  videoUploads         VideoUpload[]
  blocking             UserBlock[]           @relation("Blocker")
  blockedBy            UserBlock[]           @relation("Blocked")
  bookings             Booking[]
  packages             PackagePurchase[]
  workoutSessions      WorkoutSession[]
  cartItems            CartItem[]
  addresses            Address[]
  orders               Order[]
  payments             Payment[]
  notifications        Notification[]
  devices              DeviceToken[]
  notificationSettings NotificationSetting[]
  reports              Report[]
  partnerUsers         PartnerUser[]
  auditLogs            AuditLog[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// One-time email codes. Only a hash of the code is stored.
model EmailOtp {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String
  /// What the code is for ("sign_in", "payout"): a code only works for its own purpose.
  purpose    String    @default("sign_in")
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  ipHash     String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, purpose, createdAt])
  @@map("email_otps")
}

/// Refresh-token sessions (rotated on use; only hashes stored).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MemberProfile {
  userId         String                                 @id @db.Uuid
  goal           String?
  dateOfBirth    DateTime?                              @db.Date
  homeLocation   Unsupported("geography(Point, 4326)")?
  searchRadiusKm Int                                    @default(5)
  updatedAt      DateTime                               @updatedAt @db.Timestamptz(3)
  user           User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

// ───────────────────────────── Gyms ─────────────────────────────

model Gym {
  id                     String                                @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String                                @unique
  description            String?
  phone                  String?
  email                  String?
  addressText            String
  location               Unsupported("geography(Point, 4326)")
  openingHours           Json // { mon: [{ open: "05:00", close: "22:00" }], ... }
  facilities             String[]
  coverUrl               String?
  status                 GymStatus                             @default(draft)
  platformFeeBps         Int? // basis points override (e.g. 800 = 8%); null = platform default
  paystackSubaccountCode String?
  /// Payout account, masked: the full account number lives only at Paystack.
  payoutMethod           String? // "bank" | "mobile_money"
  payoutBankName         String?
  payoutAccountName      String?
  payoutAccountLast4     String?
  payoutUpdatedAt        DateTime?                             @db.Timestamptz(3)
  /// When the owner last sent the gym for review.
  submittedAt            DateTime?                             @db.Timestamptz(3)
  /// The BGYM team's last decision, and its note to the owner (why it was sent back or suspended).
  reviewedAt             DateTime?                             @db.Timestamptz(3)
  reviewedById           String?                               @db.Uuid
  reviewNote             String?
  createdAt              DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                              @updatedAt @db.Timestamptz(3)

  staff       GymStaff[]
  photos      GymPhoto[]
  invitations GymInvitation[]
  trainerInvitations TrainerInvitation[]
  plans       MembershipPlan[]
  memberships Membership[]
  checkIns    CheckIn[]
  posts       Post[]
  stories     Story[]
  trainers    Trainer[]

  @@index([status])
  @@map("gyms")
}

model GymStaff {
  gymId     String       @db.Uuid
  userId    String       @db.Uuid
  role      GymStaffRole
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  gym       Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gymId, userId])
  @@index([userId])
  @@map("gym_staff")
}

/// A gym's photo. Files live in object storage (or on disk in development); only keys are
/// stored here. The first photo (lowest sortOrder) is the gym's cover.
/// An invitation for someone to join a gym's staff. It can only be accepted by a person signed
/// in with the invited email address (their sign-in code proves they own it).
model GymInvitation {
  id          String       @id @default(uuid(7)) @db.Uuid
  gymId       String       @db.Uuid
  email       String
  role        GymStaffRole
  invitedById String?      @db.Uuid
  expiresAt   DateTime     @db.Timestamptz(3)
  acceptedAt  DateTime?    @db.Timestamptz(3)
  /// Revoked by staff, or declined by the person invited.
  closedAt    DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  invitedBy   User?        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, acceptedAt, closedAt])
  @@index([gymId, createdAt])
  @@map("gym_invitations")
}

model GymPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  gymId       String   @db.Uuid
  /// Storage key of the large image (1600 px wide, WebP).
  key         String
  /// Storage key of the thumbnail (480 px wide, WebP).
  thumbKey    String
  width       Int
  height      Int
  sortOrder   Int      @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, sortOrder])
  @@map("gym_photos")
}

model MembershipPlan {
  id           String       @id @default(uuid(7)) @db.Uuid
  gymId        String       @db.Uuid
  name         String
  description  String?
  durationDays Int
  pricePesewas Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([gymId, isActive])
  @@map("membership_plans")
}

model Membership {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @db.Uuid
  gymId     String               @db.Uuid
  planId    String               @db.Uuid
  status    MembershipStatus     @default(pending)
  startsAt  DateTime             @db.Timestamptz(3)
  endsAt    DateTime             @db.Timestamptz(3)
  autoRenew Boolean              @default(false)
  paymentId String?              @unique @db.Uuid
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id])
  gym       Gym                  @relation(fields: [gymId], references: [id])
  plan      MembershipPlan       @relation(fields: [planId], references: [id])
  payment   Payment?             @relation(fields: [paymentId], references: [id])
  checkIns  CheckIn[]
  reminders MembershipReminder[]

  @@index([userId, status])
  @@index([gymId, status, endsAt])
  @@map("memberships")
}

/// A renewal reminder emailed to a member. A partial unique index (in the migration) allows
/// each automatic kind once per membership; the row is written before the email is sent, so
/// two API instances can never both send it.
model MembershipReminder {
  id           String       @id @default(uuid(7)) @db.Uuid
  membershipId String       @db.Uuid
  kind         ReminderKind
  /// Staff member who sent a manual reminder; null for automatic ones.
  sentById     String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("ReminderSender", fields: [sentById], references: [id])

  @@index([membershipId, createdAt])
  @@map("membership_reminders")
}

model CheckIn {
  id           String        @id @default(uuid(7)) @db.Uuid
  membershipId String?       @db.Uuid
  gymId        String        @db.Uuid
  userId       String?       @db.Uuid
  scannedById  String        @db.Uuid
  result       CheckInResult
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  membership   Membership?   @relation(fields: [membershipId], references: [id])
  gym          Gym           @relation(fields: [gymId], references: [id])
  user         User?         @relation("CheckInMember", fields: [userId], references: [id])
  scannedBy    User          @relation("CheckInScanner", fields: [scannedById], references: [id])

  @@index([gymId, createdAt])
  @@index([userId, createdAt])
  @@map("check_ins")
}

// ───────────────────────────── Feed ─────────────────────────────

model Post {
  id           String        @id @default(uuid(7)) @db.Uuid
  gymId        String        @db.Uuid
  authorUserId String        @db.Uuid
  /// gym = posted by staff as the gym; member = a member's own post, seen by that gym's members.
  authorKind   PostAuthorKind @default(gym)
  body         String?
  status       ContentStatus @default(published)
  likeCount    Int           @default(0)
  commentCount Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorUserId], references: [id])
  media        PostMedia[]
  likes        PostLike[]
  comments     PostComment[]

  @@index([gymId, status, createdAt(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@map("posts")
}

/// A photo or a video in a post. Photos live in storage (keys only); videos are a VideoUpload.
model PostMedia {
  id            String       @id @default(uuid(7)) @db.Uuid
  postId        String       @db.Uuid
  type          MediaType
  /// Photos: storage key of the large image and its thumbnail (WebP). Null for videos.
  key           String?
  thumbKey      String?
  width         Int
  height        Int
  videoUploadId String?      @unique @db.Uuid
  playbackId    String?
  sortOrder     Int          @default(0)
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  video         VideoUpload? @relation(fields: [videoUploadId], references: [id])

  @@index([postId, sortOrder])
  @@map("post_media")
}

model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String        @id @default(uuid(7)) @db.Uuid
  postId    String        @db.Uuid
  userId    String        @db.Uuid
  body      String
  status    ContentStatus @default(published)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@map("post_comments")
}

/// A video someone is uploading. Development: the API stores and converts it (ffmpeg);
/// production: it goes straight from the phone to Cloudflare Stream.
model VideoUpload {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @db.Uuid
  purpose     VideoPurpose
  provider    String
  /// Cloudflare Stream video uid, or the local storage key of the MP4.
  providerId  String?
  posterKey   String?
  status      VideoStatus  @default(awaiting_upload)
  durationSec Float?
  width       Int?
  height      Int?
  error       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  readyAt     DateTime?    @db.Timestamptz(3)
  /// Set once a post or story uses it; a video can be used once.
  usedAt      DateTime?    @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia   PostMedia?
  story       Story?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("video_uploads")
}

/// A photo or short video that disappears after 24 hours.
model Story {
  id            String         @id @default(uuid(7)) @db.Uuid
  gymId         String         @db.Uuid
  authorUserId  String         @db.Uuid
  authorKind    PostAuthorKind
  type          MediaType
  key           String?
  thumbKey      String?
  videoUploadId String?        @unique @db.Uuid
  width         Int
  height        Int
  caption       String?
  status        ContentStatus  @default(published)
  likeCount     Int            @default(0)
  viewCount     Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  video         VideoUpload?   @relation(fields: [videoUploadId], references: [id])
  views         StoryView[]
  likes         StoryLike[]

  @@index([gymId, status, expiresAt])
  @@index([authorUserId, expiresAt])
  @@map("stories")
}

model StoryView {
  storyId  String   @db.Uuid
  userId   String   @db.Uuid
  viewedAt DateTime @default(now()) @db.Timestamptz(3)
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@map("story_views")
}

model StoryLike {
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@map("story_likes")
}

/// Someone a person never wants to see (and who can't see them) in posts, comments and stories.
model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ───────────────────────────── Trainers ─────────────────────────────

/// A personal trainer, linked to one gym (which invited them). Members see them in the app
/// once their profile, price, availability and payout account are set and they choose to be listed.
model Trainer {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  userId                 String                  @unique @db.Uuid
  gymId                  String                  @db.Uuid
  bio                    String?
  specialties            String[]
  certifications         Json                    @default("[]")
  sessionPricePesewas    Int                     @default(0)
  sessionDurationMin     Int                     @default(60)
  /// Members can cancel for free (refund, or the session back on their package) up to this many hours before.
  cancelHours            Int                     @default(24)
  cancellationPolicy     String?
  /// Profile photo (storage keys, WebP).
  photoKey               String?
  photoThumbKey          String?
  /// active = linked to the gym; suspended = removed by the gym or the BGYM team.
  status                 TrainerStatus           @default(pending)
  /// The trainer chose to appear in the app (only allowed once everything is set up).
  listed                 Boolean                 @default(false)
  /// Optional BGYM fee override for this trainer, in basis points.
  platformFeeBps         Int?
  paystackSubaccountCode String?
  payoutMethod           String?
  payoutBankName         String?
  payoutAccountName      String?
  payoutAccountLast4     String?
  payoutUpdatedAt        DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  user                   User                    @relation(fields: [userId], references: [id])
  gym                    Gym                     @relation(fields: [gymId], references: [id])
  availability           AvailabilityRule[]
  exceptions             AvailabilityException[]
  packages               TrainerPackage[]
  bookings               Booking[]
  purchases              PackagePurchase[]

  @@index([gymId, status])
  @@map("trainers")
}

/// A gym inviting a trainer by email. Only someone signed in with that email can accept.
model TrainerInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  gymId       String    @db.Uuid
  email       String
  invitedById String?   @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  closedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  gym         Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("TrainerInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, acceptedAt, closedAt])
  @@index([gymId, createdAt])
  @@map("trainer_invitations")
}

model AvailabilityRule {
  id        String  @id @default(uuid(7)) @db.Uuid
  trainerId String  @db.Uuid
  weekday   Int // 0 = Sunday … 6 = Saturday
  startTime String // "HH:mm" in Africa/Accra (UTC+0)
  endTime   String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id        String                    @id @default(uuid(7)) @db.Uuid
  trainerId String                    @db.Uuid
  date      DateTime                  @db.Date
  startTime String?
  endTime   String?
  type      AvailabilityExceptionType
  trainer   Trainer                   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, date])
  @@map("availability_exceptions")
}

model TrainerPackage {
  id            String            @id @default(uuid(7)) @db.Uuid
  trainerId     String            @db.Uuid
  name          String
  description   String?
  sessionsCount Int
  validityDays  Int
  pricePesewas  Int
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  trainer       Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  purchases     PackagePurchase[]

  @@index([trainerId, isActive])
  @@map("trainer_packages")
}

model PackagePurchase {
  id                String         @id @default(uuid(7)) @db.Uuid
  trainerPackageId  String         @db.Uuid
  trainerId         String         @db.Uuid
  userId            String         @db.Uuid
  status            PackageStatus  @default(pending)
  sessionsCount     Int
  sessionsRemaining Int
  startsAt          DateTime       @db.Timestamptz(3)
  endsAt            DateTime       @db.Timestamptz(3)
  paymentId         String?        @unique @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  trainerPackage    TrainerPackage @relation(fields: [trainerPackageId], references: [id])
  trainer           Trainer        @relation(fields: [trainerId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  payment           Payment?       @relation(fields: [paymentId], references: [id])
  bookings          Booking[]

  @@index([userId, status])
  @@index([trainerId, status])
  @@map("package_purchases")
}

model Booking {
  id                String           @id @default(uuid(7)) @db.Uuid
  trainerId         String           @db.Uuid
  userId            String           @db.Uuid
  startsAt          DateTime         @db.Timestamptz(3)
  endsAt            DateTime         @db.Timestamptz(3)
  status            BookingStatus    @default(pending)
  /// Unpaid single sessions hold the slot until then.
  holdExpiresAt     DateTime?        @db.Timestamptz(3)
  packagePurchaseId String?          @db.Uuid
  paymentId         String?          @unique @db.Uuid
  /// Something for the trainer: goals, injuries…
  note              String?
  cancelledAt       DateTime?        @db.Timestamptz(3)
  cancelledBy       BookingCanceller?
  /// Cancelled early enough for a refund (or the session back on the package).
  refundDue         Boolean          @default(false)
  remindedDayAt     DateTime?        @db.Timestamptz(3)
  remindedHourAt    DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  trainer           Trainer          @relation(fields: [trainerId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  packagePurchase   PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])
  payment           Payment?         @relation(fields: [paymentId], references: [id])

  @@index([trainerId, startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

// ───────────────────────────── Workouts ─────────────────────────────

model Exercise {
  id           String            @id @default(uuid(7)) @db.Uuid
  externalId   String            @unique // id in the licensed exercise library
  name         String
  bodyPart     String
  targetMuscle String?
  equipment    String?
  animationUrl String?
  instructions String[]
  workouts     WorkoutExercise[]

  @@map("exercises")
}

model Workout {
  id          String            @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  level       String
  durationMin Int
  coverUrl    String?
  isFree      Boolean           @default(false)
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  exercises   WorkoutExercise[]
  sessions    WorkoutSession[]

  @@map("workouts")
}

model WorkoutExercise {
  id          String   @id @default(uuid(7)) @db.Uuid
  workoutId   String   @db.Uuid
  exerciseId  String   @db.Uuid
  sortOrder   Int
  sets        Int?
  reps        Int?
  durationSec Int?
  restSec     Int?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId, sortOrder])
  @@map("workout_exercises")
}

model WorkoutSession {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  workoutId   String   @db.Uuid
  completedAt DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout  @relation(fields: [workoutId], references: [id])

  @@index([userId, completedAt])
  @@map("workout_sessions")
}

// ───────────────────────────── Store ─────────────────────────────

/// Who sells a product: BGYM itself (one "platform" seller) or a store partner.
model Seller {
  id                     String           @id @default(uuid(7)) @db.Uuid
  type                   SellerType
  name                   String
  /// BGYM's commission on a partner's sales, in basis points.
  commissionBps          Int              @default(0)
  isActive               Boolean          @default(true)
  contactEmail           String?
  contactPhone           String?
  paystackSubaccountCode String?
  payoutMethod           String?
  payoutBankName         String?
  payoutAccountName      String?
  payoutAccountLast4     String?
  payoutUpdatedAt        DateTime?        @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  orders                 Order[]
  users                  PartnerUser[]
  pickupLocations        PickupLocation[]
  products               Product[]
  orderItems             OrderItem[]

  @@map("sellers")
}

model PartnerUser {
  sellerId String @db.Uuid
  userId   String @db.Uuid
  role     String @default("manager")
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sellerId, userId])
  @@map("partner_users")
}

model PickupLocation {
  id           String                                @id @default(uuid(7)) @db.Uuid
  sellerId     String                                @db.Uuid
  addressText  String
  location     Unsupported("geography(Point, 4326)")
  contactPhone String
  seller       Seller                                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([sellerId])
  @@map("pickup_locations")
}

model Category {
  id       String     @id @default(uuid(7)) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid(7)) @db.Uuid
  sellerId    String           @db.Uuid
  categoryId  String           @db.Uuid
  title       String
  description String?
  brand       String?
  status      ProductStatus    @default(draft)
  isFeatured  Boolean          @default(false)
  /// The BGYM team's note when sending a partner's product back.
  reviewNote  String?
  publishedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  seller      Seller           @relation(fields: [sellerId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]

  @@index([status, categoryId])
  @@index([sellerId])
  @@map("products")
}

/// Product photos live in storage (WebP, large + thumbnail); only keys are stored.
model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  key       String
  thumbKey  String
  width     Int
  height    Int
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id                    String      @id @default(uuid(7)) @db.Uuid
  productId             String      @db.Uuid
  name                  String
  sku                   String      @unique
  pricePesewas          Int
  compareAtPricePesewas Int?
  stock                 Int         @default(0)
  reserved              Int         @default(0)
  weightGrams           Int?
  isActive              Boolean     @default(true)
  sortOrder             Int         @default(0)
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  orderItems            OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model CartItem {
  userId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  @@map("cart_items")
}

model Address {
  id                String                                @id @default(uuid(7)) @db.Uuid
  userId            String                                @db.Uuid
  label             String?
  location          Unsupported("geography(Point, 4326)")
  addressText       String
  landmark          String?
  gpsDigitalAddress String?
  contactPhone      String
  isDefault         Boolean                               @default(false)
  createdAt         DateTime                              @default(now()) @db.Timestamptz(3)
  user              User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// One seller's part of a checkout (each seller ships from their own pickup point, so each
/// order has its own delivery). A checkout with several sellers is one payment, several orders.
model Order {
  id                 String          @id @default(uuid(7)) @db.Uuid
  number             String          @unique // human-friendly, e.g. BG-10422
  userId             String          @db.Uuid
  sellerId           String          @db.Uuid
  pickupLocationId   String?         @db.Uuid
  status             OrderStatus     @default(pending_payment)
  subtotalPesewas    Int
  deliveryFeePesewas Int
  totalPesewas       Int
  /// BGYM's commission on a partner's items (0 for BGYM's own products).
  commissionPesewas  Int             @default(0)
  addressSnapshot    Json
  contactPhone       String
  note               String?
  paymentId          String?         @db.Uuid
  /// Stock is held for an unpaid order until then.
  reservedUntil      DateTime?       @db.Timestamptz(3)
  paidAt             DateTime?       @db.Timestamptz(3)
  cancelReason       String?
  refundDue          Boolean         @default(false)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  user               User            @relation(fields: [userId], references: [id])
  seller             Seller          @relation(fields: [sellerId], references: [id])
  pickupLocation     PickupLocation? @relation(fields: [pickupLocationId], references: [id])
  payment            Payment?        @relation(fields: [paymentId], references: [id])
  items              OrderItem[]
  delivery           Delivery?
  events             OrderEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([paymentId])
  @@map("orders")
}

/// The order's timeline, for the member's tracking screen and the seller's history.
model OrderEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  actorId   String?     @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderItem {
  id               String         @id @default(uuid(7)) @db.Uuid
  orderId          String         @db.Uuid
  variantId        String         @db.Uuid
  sellerId         String         @db.Uuid
  titleSnapshot    String
  unitPricePesewas Int
  quantity         Int
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  seller           Seller         @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model Delivery {
  id                String           @id @default(uuid(7)) @db.Uuid
  orderId           String           @unique @db.Uuid
  provider          DeliveryProvider
  externalId        String?
  status            DeliveryStatus   @default(quoted)
  courierName       String?
  courierPhone      String?
  trackingUrl       String?
  quotedFeePesewas  Int
  actualCostPesewas Int?
  distanceMeters    Int?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                 String           @id @default(uuid(7)) @db.Uuid
  userId             String           @db.Uuid
  type               PaymentType
  amountPesewas      Int
  currency           String           @default("GHS")
  status             PaymentStatus    @default(pending)
  provider           PaymentProvider
  /// Our reference, sent to the provider (e.g. the Paystack transaction reference).
  reference          String           @unique
  channel            PaymentChannel?
  platformFeePesewas Int              @default(0)
  splitDetails       Json?
  metadata           Json?
  paidAt             DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  user               User             @relation(fields: [userId], references: [id])
  events             PaymentEvent[]
  refunds            Refund[]
  membership         Membership?
  packagePurchase    PackagePurchase?
  booking            Booking?
  orders             Order[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every Paystack webhook we receive, stored for idempotency and audit.
model PaymentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  paymentId       String?  @db.Uuid
  providerEventId String   @unique
  eventType       String
  payload         Json
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  payment         Payment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id            String       @id @default(uuid(7)) @db.Uuid
  paymentId     String       @db.Uuid
  amountPesewas Int
  reason        String
  status        RefundStatus @default(pending)
  initiatedById String       @db.Uuid
  /// Paystack's refund id, and when Paystack confirmed the money was returned.
  providerRefundId String?
  processedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  payment       Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// An Expo push token for one install of the app. A token moves to whoever signed in last.
model DeviceToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  platform   DevicePlatform
  token      String         @unique
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets    PushTicket[]

  @@index([userId])
  @@map("device_tokens")
}

/// Expo accepted a push for delivery; checked later against Expo's receipts to drop dead tokens.
model PushTicket {
  id            String      @id @default(uuid(7)) @db.Uuid
  ticketId      String      @unique
  deviceTokenId String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  deviceToken   DeviceToken @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("push_tickets")
}

/// A member's choice for one topic on one channel. No row means the topic's default.
model NotificationSetting {
  userId    String   @db.Uuid
  topic     String
  channel   String
  enabled   Boolean
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic, channel])
  @@map("notification_settings")
}

model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterUserId String       @db.Uuid
  targetType     String
  targetId       String       @db.Uuid
  reason         String
  details        String?
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?    @db.Timestamptz(3)
  resolvedById   String?      @db.Uuid
  reporter       User         @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  /// One open report per person per item.
  @@unique([reporterUserId, targetType, targetId])
  @@index([status, createdAt])
  @@map("reports")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Append-only record of sensitive actions (approvals, refunds, role changes, fee changes).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
