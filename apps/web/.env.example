# Server-only settings: none of these reach the browser (sessions live in httpOnly cookies
# and the browser never talks to the API directly).

# Where this dashboard's server reaches the BGYM API.
API_URL=http://localhost:4000
# Same value as DASHBOARD_PROXY_SECRET in apps/api/.env. Lets the API rate-limit each
# visitor separately instead of treating the whole dashboard as one client.
API_PROXY_SECRET=dev-change-me-dashboard-proxy-secret-32-chars
