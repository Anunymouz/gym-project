{
  "expo": {
    "name": "BGYM",
    "slug": "bgym",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bgym",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6FA",
    "ios": {
      "bundleIdentifier": "app.bgym.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BGYM uses your location to show gyms near you and to set your delivery address.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bgym.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1028",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1028",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BGYM uses your location to show gyms near you and to set your delivery address.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5A1F",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BGYM uses your photos so you can share them in posts and stories with your gym.",
          "cameraPermission": "BGYM uses the camera so you can take photos and videos for posts and stories.",
          "microphonePermission": "BGYM uses the microphone to record sound with your videos."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "cyberscec",
    "extra": {
      "eas": {
        "projectId": "27e10e54-caf0-4f0f-a4aa-a1368a36ce8e"
      }
    }
  }
}
