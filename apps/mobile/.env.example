# Public values only (bundled into the app). Never put secrets in EXPO_PUBLIC_* variables.
# Simulator / web: http://localhost:4000. Physical phone: your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Where shared post links point (the web app's /p/<id> page).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Push notifications need an EAS project ID (free Expo account: run `npx eas-cli@latest init`
# in apps/mobile, which also writes it to app config). Not a secret.
# EXPO_PUBLIC_EAS_PROJECT_ID=
